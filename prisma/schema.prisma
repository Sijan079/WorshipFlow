generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum ServiceStatus {
  DRAFT
  READY
  ARCHIVED
}

enum ServiceVariant {
  STANDARD
  EXTENDED
}

enum AssignedMinistry {
  LEADERS
  YOUTH
  MENS
  LADIES
  MIXED
}

enum ServiceTemplateType {
  REGULAR
  FIRST_SUNDAY
}

enum PledgeType {
  PLEDGE_OF_FAITH
  COVENANT
}

enum ServiceServantRole {
  CALL_TO_WORSHIP
  EMCEE
  SCRIPTURE_READER
  SERMON_SPEAKER
  OFFERING
  PLEDGE_READER
}

enum ServiceHymnalRole {
  HYMN_OF_PREPARATION
  HYMN_OF_RESPONSE
  SONG_OF_HYMNS
}

enum BlockType {
  CUSTOM
  CALL_TO_WORSHIP
  PRAISE_AND_WORSHIP
  MC
  AWIT_NG_HIMNO
  TIPAN_PAHAYAG
  AWIT_NG_PAKIKINIG
  SCRIPTURE_READING
  SERMON
  AWIT_NG_PAGTUGON
  OFFERING
  FLOWERS_FOR_THE_LORD
  DETAILS
}

enum SongRole {
  OPENING
  PRAISE
  TRANSITION
  RESPONSE
  SPECIAL
  CUSTOM
}

enum AssetType {
  SCREENSHOT
  DOCX
  PDF
  IMAGE
  VIDEO
  EXPORT
  OTHER
}

enum JobType {
  TRANSPOSE
  FREESHOW_GENERATE
  CAPTION_GENERATE
  BACKGROUND_IMAGE_GENERATE
  BACKGROUND_VIDEO_GENERATE
}

enum JobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum ProgramBlockTypeStatus {
  ACTIVE
  ARCHIVED
}

enum ProgramBlockVersionStatus {
  DRAFT
  PUBLISHED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WorkspaceIntegrationProvider {
  OPENAI
  GEMINI
}

enum OutputType {
  FREESHOW
  DOCX
  PDF
  CAPTION_PACK
  BACKGROUND_IMAGE
  BACKGROUND_VIDEO
  ZIP
}

enum ServantGender {
  MALE
  FEMALE
}

enum ServantGroup {
  PASTORS
  CHURCH_LEADERS
  MENS
  LADIES
  YOUTH
  TECH
  MUSIC
}

model Workspace {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  logoDataUrl String? @db.Text
  serviceTemplatesInitialized Boolean @default(false)
  activeChecklistId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services  WorshipService[]
  users     User[] @relation("WorkspaceUsers")
  memberships WorkspaceMembership[]
  invitations WorkspaceInvitation[]
  papInboxScreenshots PapInboxScreenshot[]
  songs     Song[]
  tagPresets SongTagPreset[]
  ministryPresets MinistryPreset[]
  servantGroupPresets ServantGroupPreset[]
  checklistPresets ChecklistPreset[] @relation("WorkspaceChecklistPresets")
  activeChecklist ChecklistPreset? @relation("ActiveChecklist", fields: [activeChecklistId], references: [id], onDelete: SetNull)
  serviceTemplatePresets ServiceTemplatePreset[]
  programBlockTypes ProgramBlockType[]
  integrations WorkspaceIntegration[]
  automationJobs AutomationJob[]
  generatedOutputs GeneratedOutput[]
  servants  Servant[]
}

model User {
  id              String   @id @default(uuid())
  authProviderId  String   @unique
  email           String   @unique
  displayName     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspaces      Workspace[] @relation("WorkspaceUsers")
  memberships     WorkspaceMembership[]
  sentInvitations WorkspaceInvitation[] @relation("InvitationSender")
  requestedJobs   AutomationJob[]
}

model WorkspaceMembership {
  id          String           @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
}

model WorkspaceInvitation {
  id              String           @id @default(uuid())
  workspaceId     String
  email           String
  role            WorkspaceRole    @default(MEMBER)
  invitedByUserId String?
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email, status])
  @@index([email, status])
}

model WorkspaceIntegration {
  id                    String                      @id @default(uuid())
  workspaceId           String
  provider              WorkspaceIntegrationProvider
  enabled               Boolean                     @default(true)
  apiKeyCiphertext      String?
  extractorModel        String?
  backgroundImageModel  String?
  backgroundVideoModel  String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId, enabled])
}

model PapInboxScreenshot {
  id          String   @id @default(uuid())
  workspaceId String
  batchId     String
  batchIndex  Int
  batchTotal  Int
  fileName    String
  filePath    String
  mimeType    String
  size        Int
  note        String?
  deviceName  String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([batchId, createdAt])
  @@map("PAPInboxScreenshot")
}

model WorshipService {
  id            String         @id @default(uuid())
  workspaceId   String
  serviceDate   DateTime
  ministryName  String
  ministryPresetCode String?
  assignedMinistry AssignedMinistry?
  sermonVerse   String?
  theme         String?
  status        ServiceStatus  @default(DRAFT)
  serviceVariant ServiceVariant @default(STANDARD)
  templateType  ServiceTemplateType @default(REGULAR)
  templatePresetCode String?
  pledgeType    PledgeType?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blocks        WorshipServiceBlock[]
  songs         WorshipServiceSong[]
  details       WorshipServiceDetail[]
  bibleVerses   ServiceBibleVerse[]
  servantAssignments ServiceServantAssignment[]
  hymnals       ServiceHymnal[]
  assets        ServiceAsset[]
  jobs          AutomationJob[]
  outputs       GeneratedOutput[]

  @@index([workspaceId, serviceDate])
}

model WorshipServiceBlock {
  id          String     @id @default(uuid())
  serviceId   String
  blockType   BlockType
  label       String?
  code        String?
  order       Int
  typeVersionId String?
  fieldValues Json @default("{}")

  service     WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  typeVersion ProgramBlockTypeVersion? @relation(fields: [typeVersionId], references: [id], onDelete: Restrict)

  people      BlockPerson[]
  songs       WorshipServiceSong[]
  details     WorshipServiceDetail[]

  createdAt   DateTime @default(now())
}

model BlockPerson {
  id          String   @id @default(uuid())
  blockId     String

  personName  String
  personTitle String?

  order       Int @default(0)

  block       WorshipServiceBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model Song {
  id           String   @id @default(uuid())
  workspaceId  String
  title        String
  author       String?
  defaultKey   String?
  bpm          Int?
  language     String?
  isOriginal   Boolean  @default(false)

  createdAt    DateTime @default(now())

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  files        SongFile[]
  serviceSongs WorshipServiceSong[]

  @@index([workspaceId, title])
}

model SongFile {
  id          String   @id @default(uuid())
  songId      String

  fileName    String
  filePath    String
  version     String?

  createdAt   DateTime @default(now())

  song        Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model SongTagPreset {
  id        String   @id @default(uuid())
  workspaceId String
  label     String
  token     String
  color     String
  isDefault Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, token])
}

model MinistryPreset {
  id          String   @id @default(uuid())
  workspaceId String
  label       String
  code        String
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
}

model ServantGroupPreset {
  id          String   @id @default(uuid())
  workspaceId String
  label       String
  code        String
  active      Boolean  @default(true)
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
}

model ChecklistPreset {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation("WorkspaceChecklistPresets", fields: [workspaceId], references: [id], onDelete: Cascade)
  activeForWorkspaces Workspace[] @relation("ActiveChecklist")
  items       ChecklistItemPreset[]

  @@index([workspaceId, name])
}

model ChecklistItemPreset {
  id          String   @id @default(uuid())
  checklistId String
  label       String
  order       Int      @default(0)
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklist   ChecklistPreset @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId, order])
}

model ServiceTemplatePreset {
  id             String              @id @default(uuid())
  workspaceId    String
  label          String
  code           String
  templateType   ServiceTemplateType
  optionalBlocks BlockType[]
  blocks         Json                @default("[]")
  active         Boolean             @default(true)
  isDefault      Boolean             @default(false)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templateBlocks ServiceTemplateBlock[]

  @@unique([workspaceId, code])
}

model ProgramBlockType {
  id          String                 @id @default(uuid())
  workspaceId String
  key         String
  label       String
  description String?
  status      ProgramBlockTypeStatus @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions    ProgramBlockTypeVersion[]
  templateBlocks ServiceTemplateBlock[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status, label])
}

model ProgramBlockTypeVersion {
  id          String                    @id @default(uuid())
  typeId      String
  version     Int
  definition  Json
  status      ProgramBlockVersionStatus  @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime                  @default(now())

  type        ProgramBlockType           @relation(fields: [typeId], references: [id], onDelete: Cascade)
  templateBlocks ServiceTemplateBlock[]
  serviceBlocks WorshipServiceBlock[]

  @@unique([typeId, version])
  @@index([typeId, status])
}

model ServiceTemplateBlock {
  id             String   @id @default(uuid())
  templateId     String
  typeId         String
  typeVersionId  String
  label          String?
  order          Int
  active         Boolean  @default(true)
  fieldDefaults  Json     @default("{}")

  template       ServiceTemplatePreset @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type           ProgramBlockType      @relation(fields: [typeId], references: [id], onDelete: Restrict)
  typeVersion    ProgramBlockTypeVersion @relation(fields: [typeVersionId], references: [id], onDelete: Restrict)

  @@unique([templateId, order])
  @@index([templateId, active, order])
}

model WorshipServiceSong {
  id          String @id @default(uuid())

  serviceId   String
  blockId     String
  songId      String

  order       Int
  songRole    SongRole

  pageRef     String?

  service     WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  block       WorshipServiceBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  song        Song @relation(fields: [songId], references: [id], onDelete: Cascade)
}

model WorshipServiceDetail {
  id          String @id @default(uuid())

  serviceId   String
  blockId     String?
  key         String
  value       String

  service     WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  block       WorshipServiceBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)
}

model ServiceBibleVerse {
  id        String @id @default(uuid())
  serviceId String
  verse     String
  order     Int    @default(0)

  service   WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, order])
}

model ServiceServantAssignment {
  id         String @id @default(uuid())
  serviceId  String
  role       ServiceServantRole
  personName String

  service    WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, role])
  @@index([serviceId])
}

model ServiceHymnal {
  id        String @id @default(uuid())
  serviceId String
  role      ServiceHymnalRole
  title     String

  service   WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, role])
  @@index([serviceId])
}

model ServiceAsset {
  id          String @id @default(uuid())

  serviceId   String
  type        AssetType

  fileName    String
  filePath    String

  createdAt   DateTime @default(now())

  service     WorshipService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model AutomationJob {
    id          String @id @default(uuid())

    workspaceId String
    serviceId   String?
    requestedByUserId String?
    jobType     JobType
    status      JobStatus @default(QUEUED)

  inputJson   Json?
  outputJson  Json?

  createdAt   DateTime @default(now())
  completedAt DateTime?

    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    service     WorshipService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
    requestedBy User? @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)

    outputs     GeneratedOutput[]

    @@index([workspaceId, createdAt])
  }

model GeneratedOutput {
    id          String @id @default(uuid())

    workspaceId String
    serviceId   String?
    jobId       String?

  type        OutputType
  filePath    String

  createdAt   DateTime @default(now())

    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    service     WorshipService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
    job         AutomationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

    @@index([workspaceId, createdAt])
  }

model Servant {
  id          String        @id @default(uuid())
  workspaceId String
  name        String
  gender      ServantGender?
  group       ServantGroup?
  groupCode   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, name])
  @@index([workspaceId, group, name])
}
