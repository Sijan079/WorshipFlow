DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require"

# Required by Prisma for migrations and deployment.
# Use the direct Supabase database connection, not the transaction pooler.
DIRECT_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Internal/default workspace fallback used by local jobs and legacy data scripts.
WORSHIP_WORKSPACE_SLUG="angeles-city-bible-church"

# Optional AI cleanup for Song Formatter/extractor fallback.
OPENAI_API_KEY=""
WORKSPACE_INTEGRATION_ENCRYPTION_KEY=""
OPENAI_EXTRACTOR_MODEL="gpt-4.1-mini"

# Optional AI media generation for Media Tools background generation.
# Images use OpenAI. Video generation is disabled until a new provider is selected.
# Leave provider keys unset to use local mock outputs during development.
OPENAI_BACKGROUND_IMAGE_MODEL="gpt-image-1"
OPENAI_BACKGROUND_IMAGE_ESTIMATED_COST_USD="0.04"
GEMINI_API_KEY=""
GEMINI_BACKGROUND_VIDEO_MODEL=""
MEDIA_GENERATION_IMAGE_HOURLY_LIMIT="5"
MEDIA_GENERATION_IMAGE_DAILY_LIMIT="25"
MEDIA_GENERATION_VIDEO_HOURLY_LIMIT="1"
MEDIA_GENERATION_VIDEO_DAILY_LIMIT="3"

# Phone Transfer / PAP
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Supabase
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
# Hosted Google OAuth is configured in Supabase Dashboard → Authentication → Providers.
# Local Docker Supabase reads these server-only values from the ignored root .env.
# Never expose either value through NEXT_PUBLIC_*.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=""
# Use Supabase Postgres by setting DATABASE_URL above to the pooled connection string.
# Server-only private storage for temporary PAP uploads and generated outputs.
SUPABASE_URL=""
SUPABASE_PRIVATE_BUCKET="worship-flow-private"

# Removed from this template: APP_ACCESS_USER, APP_ACCESS_PASSWORD, and
# APP_ACCESS_SESSION_SECRET. The old shared-password gate is no longer a
# supported authentication path; use Supabase Auth instead.
