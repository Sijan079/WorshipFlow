# WorshipFlow environment. Copy to .env and fill in. Every value is server-only
# unless its name starts with NEXT_PUBLIC_. Never commit the real file.

# --- Required ---------------------------------------------------------------

# Database (Supabase Postgres). Runtime uses the pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require"
# Prisma migrations and deploys use the direct connection, not the pooler.
DIRECT_DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Supabase Auth and Storage.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
# Private bucket for generated outputs and temporary uploads.
SUPABASE_PRIVATE_BUCKET="worship-flow-private"

# Public base URL of this deployment (used by the provisioning script).
APP_URL="http://localhost:3000"

# --- Scheduled jobs (set in the Vercel Production environment) ---------------

# Daily keep-alive that stops a Supabase Free project from pausing. Vercel sends
# it as "Authorization: Bearer <secret>". Random, at least 32 characters.
CRON_SECRET=
# Protects /api/internal/formatter-cleanup the same way.
FORMATTER_CLEANUP_SECRET=

# --- Sermon Captions (leave empty to disable captions) ----------------------

# The Deepgram key needs Member permission so browser tokens can be issued.
DEEPGRAM_API_KEY=""
AZURE_TRANSLATOR_KEY=""
AZURE_TRANSLATOR_REGION=""
# Optional: Settings > Usage balance lookup. Use a separate key with billing:read.
DEEPGRAM_BILLING_API_KEY=""
DEEPGRAM_PROJECT_ID=""

# --- Optional ---------------------------------------------------------------

# AI cleanup for the Song Formatter and the background tools.
OPENAI_API_KEY=""
OPENAI_EXTRACTOR_MODEL="gpt-4.1-mini"
# Encrypts per-workspace AI keys saved in Settings > Integrations.
WORKSPACE_INTEGRATION_ENCRYPTION_KEY=""
# Media Tools background generation. Unset keys use local mock outputs.
OPENAI_BACKGROUND_IMAGE_MODEL="gpt-image-1"
OPENAI_BACKGROUND_IMAGE_ESTIMATED_COST_USD="0.04"
GEMINI_API_KEY=""
GEMINI_BACKGROUND_VIDEO_MODEL=""
MEDIA_GENERATION_IMAGE_HOURLY_LIMIT="5"
MEDIA_GENERATION_IMAGE_DAILY_LIMIT="25"
MEDIA_GENERATION_VIDEO_HOURLY_LIMIT="1"
MEDIA_GENERATION_VIDEO_DAILY_LIMIT="3"
# Path to a manually installed local Real-ESRGAN executable.
REALESRGAN_EXECUTABLE=""
# Token used by the in-app feedback route.
GITHUB_TOKEN=""
# OpenTelemetry export for usage metrics.
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=""
# Only when the API is served from a different origin than the app.
NEXT_PUBLIC_API_URL=""

# --- Local Docker Supabase only (npm run dev:docker) -------------------------

# Hosted Google sign-in is configured in the Supabase dashboard instead.
# Never expose either value through NEXT_PUBLIC_*.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=""
