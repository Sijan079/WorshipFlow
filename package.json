{
  "name": "worship_flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cleanup:formatter": "node --env-file-if-exists=.env.local.docker --experimental-strip-types scripts/cleanup-formatter-drafts.ts",
    "test:formatter-drafts": "node --env-file=.env.local.docker --experimental-strip-types --test scripts/test-formatter-drafts.integration.ts",
    "dev": "npm run dev:docker",
    "dev:docker": "node --env-file=.env.local.docker scripts/dev-docker.mjs",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types src/security-tests.ts",
    "test:formatter-file": "node --experimental-strip-types scripts/inspect-formatter-file.ts",
    "test:song-editor": "node --experimental-strip-types --test src/features/song-formatter/*.test.ts src/lib/workspace-formatter-navigation.test.ts",
    "test:observability": "node --experimental-strip-types --test src/lib/observability.test.ts",
    "verify:song-editor": "node --experimental-strip-types scripts/verify-song-editor.mjs",
    "test:migrations": "node scripts/verify-current-migration-order.mjs",
    "seed:song-tags": "tsx prisma/seed-song-tags.ts",
    "provision:workspace": "tsx scripts/provision-workspace.ts",
    "migrate:default-workspace": "tsx scripts/migrate-default-workspace.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@napi-rs/canvas": "^0.1.80",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.100.14",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.42.2",
    "next": "16.3.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "postgres": "^3.4.9",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.3",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.15",
    "prisma": "6.19.0",
    "supabase": "^2.113.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
